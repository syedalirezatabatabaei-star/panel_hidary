# Copy this file to .env and replace every placeholder.
# Use hexadecimal passwords for MYSQL_PASSWORD so DATABASE_URL remains URL-safe.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_HEX_ROOT_PASSWORD
MYSQL_DATABASE=panel_hidary
MYSQL_USER=panel_user
MYSQL_PASSWORD=REPLACE_WITH_LONG_RANDOM_HEX_MYSQL_PASSWORD

POSTGRES_DB=panel_hidary_analytics
POSTGRES_USER=panel_analytics
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_POSTGRES_PASSWORD

# Backend authentication (never commit the real .env file)
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
ADMIN_FULL_NAME=مدیر کل

# Same-origin frontend/API deployment; CORS is not needed by default.
CORS_ORIGINS=
